"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outcome": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "clarification_required"
            },
            "questions": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1
                  },
                  "why": {
                    "type": "string",
                    "minLength": 1
                  },
                  "options": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "allow_free_text": {
                    "default": true,
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "question",
                  "why"
                ]
              }
            }
          },
          "required": [
            "status",
            "questions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "summary": {
              "type": "string"
            },
            "files_changed": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tests_run": {
              "default": false,
              "type": "boolean"
            },
            "handoff": {
              "type": "string",
              "minLength": 1
            },
            "memoryUsed": {
              "description": "The ids of the memory entries you were given and relied on in this work. Leave out any you were not given.",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "branch",
            "summary",
            "handoff"
          ]
        }
      ]
    }
  },
  "required": [
    "outcome"
  ]
}"
`;

