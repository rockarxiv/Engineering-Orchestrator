{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["EO_EXPECT_CGROUP_CONTAINMENT", "EO_LOOK_TRACE"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "passThroughEnv": ["EO_EXPECT_CGROUP_CONTAINMENT", "EO_LOOK_TRACE"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
